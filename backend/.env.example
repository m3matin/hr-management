# Local PostgreSQL may use a self-signed certificate. Keep DB_SSL=true and
# set DB_SSL_REJECT_UNAUTHORIZED=false only for a trusted local database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
PORT=4000
NODE_ENV=development

DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_LOGGING=false
DB_SYNC_ON_START=false

# Local defaults: hr.admin@acme.com / ChangeMe123!
# Set explicit values before deploying; production requires all three values.
HR_ADMIN_EMAIL=hr.admin@acme.com
HR_ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Set true only until the first HR user is created, then set false.
ALLOW_INITIAL_REGISTRATION=true
CORS_ORIGIN=http://localhost:5173

SEED_EMPLOYEE_COUNT=10000
SEED_BATCH_SIZE=500
SEED_RANDOM_SEED=20260924
SEED_REFERENCE_DATE=2026-09-24
SEED_TRUNCATE=true