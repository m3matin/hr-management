{
  "name": "hr-management-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "auth:token": "tsx scripts/generate-token.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:sync": "tsx scripts/sync-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "seed": "npm run db:seed",
    "seed:10k": "tsx scripts/seed-10000.ts",
    "seed:10k:append": "tsx scripts/seed-10000.ts --append",
    "db:repair": "tsx scripts/repair-legacy-salary-fk.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
